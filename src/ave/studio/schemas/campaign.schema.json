{
  "$comment": "Spec 2.3. A planning envelope only; it carries no approval or send authority.",
  "type": "object",
  "required": [
    "v",
    "id",
    "name",
    "status",
    "accounts",
    "created"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^c_[A-Za-z0-9_-]{1,60}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "done",
        "dropped"
      ]
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "per_week": {
            "type": "integer",
            "minimum": 0
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brief": {
      "type": "string"
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "type": "string"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "milestones": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date",
          "done"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
