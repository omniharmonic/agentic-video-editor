{
  "$comment": "Spec 2.7: a line of ledger/events.jsonl. actor.kind is advisory, not a security boundary.",
  "type": "object",
  "required": ["ts", "actor", "op"],
  "properties": {
    "ts": {"type": "string"},
    "actor": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {"kind": {"enum": ["human", "agent", "scheduler"]}, "name": {"type": "string"}}
    },
    "post": {"type": ["string", "null"]},
    "variant": {"type": ["string", "null"]},
    "op": {"type": "string", "minLength": 1},
    "rev": {"type": ["integer", "null"]},
    "before_sha": {"type": ["string", "null"]},
    "after_sha": {"type": ["string", "null"]},
    "detail": {"type": "object"}
  }
}
