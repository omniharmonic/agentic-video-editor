{
  "$comment": "Spec 2.1.1: studio.json. title/show/speakers exist so episode-metadata readers run unchanged on a StudioProject.",
  "type": "object",
  "required": ["v", "kind", "title", "tz"],
  "properties": {
    "v": {"const": 1},
    "kind": {"const": "studio"},
    "title": {"type": "string", "minLength": 1},
    "show": {"type": "string"},
    "speakers": {"type": "object"},
    "tz": {"type": "string", "minLength": 1},
    "layout": {"type": ["object", "string"]},
    "approval": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["typed", "pin_after_review"]},
        "ttl_days": {"type": "integer", "minimum": 1},
        "agent_retime_approved": {"enum": ["propose_only", "allow"]}
      }
    },
    "dedupe_days": {"type": "integer", "minimum": 0},
    "late_after_min": {"type": "integer", "minimum": 0},
    "created": {"type": "string"}
  }
}
